{
    "compilerOptions": {
        "target": "es5",
        "module": "CommonJS",
        "lib": ["dom", "esnext"],
        "jsx": "react-jsx",
        "moduleResolution": "node",
        "allowJs": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "useDefineForClassFields": false,
        "strict": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "baseUrl": "./src",
        "types": ["jest", "@testing-library/jest-dom"],
        "paths": {
            "app/*": ["app/*"],
            "composites/*": ["composites/*"],
            "entities/*": ["entities/*"],
            "features/*": ["features/*"],
            "layouts/*": ["layouts/*"],
            "pages/*": ["pages/*"],
            "shared/*": ["shared/*"],
            "styles/*": ["styles/*"]
        }
    },
    "include": [
        "src/**/*",
        "tests/**/*",
        "jest.config.ts",
        "jest.setup.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}
